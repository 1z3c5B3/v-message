{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V-Message",
  "version": "2.4.0",
  "identifier": "com.vmessage.app",
  "build": {
    "beforeBuildCommand": "cd ../../ && npm run build",
    "beforeDevCommand": "cd ../../ && npm run dev",
    "devUrl": "http://localhost:3001",
    "frontendDist": "C:\\Users\\Вадим\\Desktop\\v-msg-final\\dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "V-Message",
        "width": 400,
        "height": 800,
        "minWidth": 320,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon_foreground.png",
      "icons/icon_background.png"
    ],
    "resources": [],
    "android": {
      "minSdkVersion": 24
    }
  }
}
